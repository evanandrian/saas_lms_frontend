# saas_lms_frontend — contoh konfigurasi environment
# Salin menjadi .env:  cp .env.example .env
# Berisi PLACEHOLDER saja. Jangan pernah mengisi rahasia, token, password,
# atau URL yang memuat kredensial di file ini maupun di .env.
# Penamaan mengikuti SAD Bagian III §6.2 (awalan PUBLIC_ untuk variabel yang boleh terlihat di browser).

# Root domain untuk resolusi host di hooks.server.ts (ADR-019).
# Dibaca saat runtime ($env/dynamic/public). Tanpa nilai, semua host ditolak (404).
# Lokal: publik = localhost, platform = platform.localhost, tenant = <subdomain>.localhost.
PUBLIC_LMS_ROOT_DOMAIN=localhost

# URL backend LMS untuk panggilan server-side (SSR/form action), server-only — JANGAN beri awalan PUBLIC_ (ADR-019/020).
# Dipakai login, verifikasi sesi, dan logout (FE-06). Kosong saat dev → http://localhost:8080; produksi wajib diisi.
LMS_API_INTERNAL_URL=http://localhost:8080

# Batas ukuran body request adapter-node (produksi). Pengaturan Akun mengirim foto profil (maks. 2 MB)
# dan dokumen pengajuan (maks. 5 MB) sebagai base64 lewat form action → perlu ±8 MB. Default adapter-node 512K.
BODY_SIZE_LIMIT=8M
